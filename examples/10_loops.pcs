// FOR, WHILE and REPEAT loops, nested loops
DECLARE i, j, Total, Number : INTEGER
DECLARE Row : STRING

Total <- 0
FOR i <- 10 TO 1 STEP -3
    OUTPUT "Countdown: ", i
NEXT i

Number <- 27
Total <- 0
WHILE Number <> 1 DO
    IF Number MOD 2 = 0 THEN
        Number <- Number DIV 2
    ELSE
        Number <- 3 * Number + 1
    ENDIF
    Total <- Total + 1
ENDWHILE
OUTPUT "Collatz steps for 27: ", Total

i <- 0
REPEAT
    i <- i + 1
UNTIL i * i > 50
OUTPUT "Smallest i with i*i > 50: ", i

FOR i <- 1 TO 4
    Row <- ""
    FOR j <- 1 TO i
        Row <- Row & "*"
    NEXT j
    OUTPUT Row
NEXT i
