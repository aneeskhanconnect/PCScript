// Procedures, BYVAL and BYREF
PROCEDURE Swap(BYREF A : INTEGER, BYREF B : INTEGER)
    DECLARE Temp : INTEGER
    Temp <- A
    A <- B
    B <- Temp
ENDPROCEDURE

PROCEDURE AddOne(BYVAL N : INTEGER)
    N <- N + 1
    OUTPUT "Inside AddOne: ", N
ENDPROCEDURE

PROCEDURE Greet(Name : STRING)
    OUTPUT "Hello, ", Name, "!"
ENDPROCEDURE

PROCEDURE Fill(BYREF Data : ARRAY OF INTEGER)
    DECLARE i : INTEGER
    FOR i <- 1 TO 3
        Data[i] <- i * 10
    NEXT i
ENDPROCEDURE

DECLARE X, Y : INTEGER
DECLARE List : ARRAY[1:3] OF INTEGER
X <- 3
Y <- 8
CALL Swap(X, Y)
OUTPUT "X = ", X, ", Y = ", Y
CALL AddOne(X)
OUTPUT "After AddOne X is still ", X
CALL Greet("Sara")
CALL Fill(List)
OUTPUT List[1], " ", List[2], " ", List[3]
