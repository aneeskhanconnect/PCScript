#include "resource.h"
#include <winver.h>

IDI_APP ICON "../assets/app.ico"
IDI_PCS_FILE ICON "../assets/pcs_file.ico"
1 24 "studio.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 2,0,0,0
 PRODUCTVERSION 2,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "PCScript"
            VALUE "FileDescription", "PCScript Studio - pseudocode IDE"
            VALUE "FileVersion", "2.0.0.0"
            VALUE "InternalName", "pcscript-studio"
            VALUE "OriginalFilename", "pcscript-studio.exe"
            VALUE "ProductName", "PCScript Studio"
            VALUE "ProductVersion", "2.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
