### division by zero
DECLARE a : INTEGER
a <- 0
OUTPUT 10 / a
>>> error R301
### MOD by zero
DECLARE a : INTEGER
a <- 0
OUTPUT 10 MOD a
>>> error R301
### array index above bound
DECLARE A : ARRAY[1:3] OF INTEGER
DECLARE i : INTEGER
i <- 4
A[i] <- 1
>>> error R302 out of bounds (valid range 1 to 3)
### array index below bound
DECLARE A : ARRAY[0:2] OF INTEGER
OUTPUT A[-1]
>>> error R302
### 2D array bound reports the dimension
DECLARE A : ARRAY[1:2, 1:2] OF INTEGER
A[1, 3] <- 1
>>> error R302 dimension 2
### type mismatch only detectable at run time
TYPE R
    DECLARE N : INTEGER
ENDTYPE
DECLARE x : R
x.N <- "text"
>>> error R303
### invalid INTEGER input
DECLARE n : INTEGER
INPUT n
>>> in
abc
>>> error R304
### INPUT with no data left
DECLARE n : INTEGER
INPUT n
>>> error R309
### calling a method on an object that was never created
CLASS C
    PUBLIC PROCEDURE Go()
        OUTPUT 1
    ENDPROCEDURE
ENDCLASS
DECLARE o : C
CALL o.Go()
>>> error R305
### dereferencing an unset pointer
TYPE P = ^INTEGER
DECLARE q : P
OUTPUT q^
>>> error R305
### function that never returns
FUNCTION F(n : INTEGER) RETURNS INTEGER
    IF n > 5 THEN
        RETURN 1
    ENDIF
ENDFUNCTION
OUTPUT F(1)
>>> error R305
### INTEGER overflow is detected
DECLARE x : INTEGER
x <- 9223372036854775807
x <- x + 1
>>> error R317
### invalid built-in arguments
OUTPUT MID("abc", 2, 9)
>>> error R316
### STR_TO_NUM of non-number
OUTPUT STR_TO_NUM("abc")
>>> error R304
### SETDATE rejects impossible dates
OUTPUT SETDATE(31, 2, 2024)
>>> error R316
### reading past the end of a file
OPENFILE "pcs_empty.tmp" FOR WRITE
CLOSEFILE "pcs_empty.tmp"
DECLARE s : STRING
OPENFILE "pcs_empty.tmp" FOR READ
READFILE "pcs_empty.tmp", s
>>> error R306
### writing to a file opened for reading
OPENFILE "pcs_empty.tmp" FOR READ
WRITEFILE "pcs_empty.tmp", "x"
>>> error R306
### using a file that is not open
WRITEFILE "never_opened.txt", "x"
>>> error R306
### error occurs after earlier output was produced
OUTPUT "before"
OUTPUT 1 DIV 0
>>> error R301
### a second DECLARE of the same name at run time is an error
DECLARE i : INTEGER
DECLARE s : STRING
IF TRUE THEN
    DECLARE i : INTEGER
ENDIF
>>> error E202
