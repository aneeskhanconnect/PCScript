### string functions
OUTPUT LENGTH("hello"), " ", LEFT("hello", 2), " ", RIGHT("hello", 3), " ", MID("hello", 2, 3), " ", SUBSTRING("hello", 1, 1)
OUTPUT UCASE("abC"), " ", LCASE("ABc"), " ", TO_UPPER("xy"), " ", TO_LOWER("XY")
OUTPUT UCASE('a'), LCASE('B')
>>> out
5 he llo ell h
ABC abc XY xy
Ab
### CHR and ASC
OUTPUT ASC('A'), " ", CHR(66), " ", ASC("a"), " ", CHR(ASC('c') + 1)
>>> out
65 B 97 d
### numeric functions
OUTPUT INT(3.9), " ", INT(-3.9), " ", INT(7), " ", ROUND(2.567, 1), " ", ROUND(2.5, 0)
>>> out
3 -3 7 2.6 3
### RAND stays within range
DECLARE i : INTEGER
DECLARE ok : BOOLEAN
ok <- TRUE
FOR i <- 1 TO 200
    IF RAND(10) < 0 OR RAND(10) >= 10 THEN
        ok <- FALSE
    ENDIF
NEXT i
OUTPUT ok
>>> out
TRUE
### conversions
OUTPUT NUM_TO_STR(12), "|", NUM_TO_STR(2.5), "|", STR_TO_NUM("42") + 1, "|", STR_TO_NUM("2.5") * 2
OUTPUT IS_NUM("12"), " ", IS_NUM("1.5"), " ", IS_NUM("abc"), " ", IS_NUM(""), " ", IS_NUM("-7")
>>> out
12|2.5|43|5
TRUE TRUE FALSE FALSE TRUE
### dates
DECLARE d : DATE
d <- SETDATE(25, 12, 2024)
OUTPUT d, " ", DAY(d), " ", MONTH(d), " ", YEAR(d), " ", DAYINDEX(d)
OUTPUT DAYINDEX(SETDATE(1, 1, 1970)), " ", DAYINDEX(SETDATE(29, 2, 2024))
OUTPUT SETDATE(1, 3, 2024) > SETDATE(29, 2, 2024), " ", YEAR(TODAY()) >= 2024
>>> out
25/12/2024 25 12 2024 4
5 5
TRUE TRUE
